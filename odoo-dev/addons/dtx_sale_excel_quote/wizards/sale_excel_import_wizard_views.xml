<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Excel Wizard Form -->
    <record id="view_sale_excel_import_wizard_form" model="ir.ui.view">
        <field name="name">sale.excel.import.wizard.form</field>
        <field name="model">sale.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Báo giá Excel">
                <group>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="import_mode" widget="radio"/>
                    </group>
                </group>

                <group>
                    <field name="file" filename="filename" required="1"/>
                </group>

                <div class="alert alert-info" role="alert">
                    <h4>Hướng dẫn:</h4>
                    <ul>
                        <li><b>Thay thế toàn bộ:</b> Xóa tất cả dòng hiện tại và import dòng mới từ Excel</li>
                        <li><b>Thêm vào:</b> Giữ nguyên dòng hiện tại và thêm dòng mới từ Excel</li>
                        <li>File Excel phải theo đúng template DTX với header: STT | MÔ TẢ | MÃ SP | ...</li>
                        <li>Mã sản phẩm phải tồn tại trong hệ thống</li>
                        <li>VAT sẽ được tự động map theo tỷ lệ (0%, 8%, 10%)</li>
                    </ul>
                </div>

                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

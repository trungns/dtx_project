<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DTX Security Groups -->
    <record id="group_dtx_ceo" model="res.groups">
        <field name="name">DTX CEO</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">CEO - Full access to all sales and contracts</field>
    </record>

    <record id="group_dtx_sales_director" model="res.groups">
        <field name="name">DTX Sales Director</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Sales Director - Full access to sales and contracts</field>
    </record>

    <record id="group_dtx_chief_accountant" model="res.groups">
        <field name="name">DTX Chief Accountant</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="comment">Chief Accountant - Full read/write access to sales and contracts</field>
    </record>

    <record id="group_dtx_sales_user" model="res.groups">
        <field name="name">DTX Sales User</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Sales User - Access to own quotations and PAKDs only</field>
    </record>

    <!-- DTX UI Simplified Group -->
    <record id="group_dtx_ui_simplified" model="res.groups">
        <field name="name">DTX Sales UI (Simplified)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Users with simplified Sales Order view (hides unused fields)</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PAKD Tree View -->
    <record id="view_dtx_pakd_tree" model="ir.ui.view">
        <field name="name">dtx.pakd.tree</field>
        <field name="model">dtx.pakd</field>
        <field name="arch" type="xml">
            <tree string="Phương án kinh doanh"
                  decoration-info="state=='draft'"
                  decoration-primary="state=='submitted'"
                  decoration-success="state=='approved'"
                  decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="end_customer_id"/>
                <field name="owner_user_id"/>
                <field name="state"/>
                <field name="total_contract_untaxed" sum="Tổng giá HĐ"/>
                <field name="total_purchase" sum="Tổng giá nhập"/>
                <field name="expected_profit" sum="Tổng lãi"/>
                <field name="expected_margin_percent" avg="TB margin"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- PAKD Form View -->
    <record id="view_dtx_pakd_form" model="ir.ui.view">
        <field name="name">dtx.pakd.form</field>
        <field name="model">dtx.pakd</field>
        <field name="arch" type="xml">
            <form string="Phương án kinh doanh">
                <header>
                    <button name="action_submit" type="object" string="Trình duyệt"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" type="object" string="Phê duyệt"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_reject" type="object" string="Từ chối"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'submitted'])]}"/>
                    <button name="action_reset_draft" type="object" string="Chuyển về nháp"
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button name="action_open_apply_wizard" type="object" string="Apply vào Báo giá"
                            class="btn-primary" icon="fa-check"/>
                    <button name="action_view_sale_order" type="object" string="Xem Báo giá"
                            icon="fa-external-link"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="end_customer_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="owner_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Chi tiết sản phẩm" name="lines">
                            <field name="line_ids">
                                <tree string="Chi tiết PAKD" editable="bottom">
                                    <control>
                                        <create string="Add a product"/>
                                        <create string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>

                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" invisible="1"/>

                                    <!-- Section/Note rendering -->
                                    <field name="name"
                                           widget="section_and_note_text"
                                           optional="show"/>

                                    <!-- Normal line fields -->
                                    <field name="section_type" optional="show"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="product_id"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"
                                           options="{'no_create': True}"/>
                                    <field name="product_code" readonly="1" optional="hide"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="qty"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="uom_id" groups="uom.group_uom"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="product_uom_category_id" invisible="1"/>

                                    <!-- Price fields matching Excel -->
                                    <field name="estimate_unit_excl_vat" optional="hide"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="vendor_list_price" optional="hide"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="discount_percent" optional="hide"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="purchase_unit_price"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="sale_unit_price"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="contract_unit_price"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="vat_percent"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="tax_id" optional="hide"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"
                                           options="{'no_create': True, 'no_open': True}"/>

                                    <!-- Computed totals matching Excel -->
                                    <field name="estimate_total_excl_vat" optional="hide" sum="Tổng DT (chưa VAT)"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="estimate_total_incl_vat" optional="hide" sum="Tổng DT (có VAT)"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="purchase_total" sum="Tổng nhập"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="sale_total" optional="hide" sum="Tổng bán"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="contract_total_excl_vat" sum="Tổng HĐ (chưa VAT)"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="contract_tax_amount" optional="show" sum="Tổng VAT"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="contract_total_incl_vat" sum="Tổng HĐ (có VAT)"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="line_profit" sum="Tổng lãi"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    <field name="line_margin_percent" avg="TB margin"
                                           attrs="{'invisible': [('display_type', '!=', False)]}"/>

                                    <field name="currency_id" invisible="1"/>
                                    <field name="company_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Tổng kết" name="totals">
                            <group>
                                <group string="Tổng giá từ sản phẩm">
                                    <field name="total_purchase" widget="monetary"
                                           string="1. Tổng tiền nhập (chi phí đầu vào)"/>
                                    <field name="total_sale" widget="monetary"
                                           string="2. Tổng tiền bán (chi phí thứ vỡ)"/>
                                </group>
                                <group string="Tổng giá hợp đồng">
                                    <field name="total_contract_untaxed" widget="monetary"
                                           string="3a. Tổng tiền HĐ (chưa VAT)"/>
                                    <field name="total_contract_tax" widget="monetary"
                                           string="3b. Tổng VAT"/>
                                    <field name="total_contract_total" widget="monetary"
                                           string="3. Tổng tiền HĐ (bao gồm chi phí ghi nêu cả)"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>

                            <separator string="Phần chi phí cho khách hàng/người giới thiệu"/>
                            <group>
                                <group string="Chi phí từ chênh lệch giá">
                                    <field name="price_diff" widget="monetary"
                                           string="4. Chênh lệch giá"
                                           class="oe_subtotal_footer_separator"/>
                                    <label for="tax_withheld_percent" string="5. Thu thuế"/>
                                    <div class="o_row">
                                        <field name="tax_withheld_percent" class="oe_inline"/> %
                                        <span class="mx-2">=</span>
                                        <field name="tax_withheld_amount" widget="monetary" readonly="1" class="oe_inline"/>
                                    </div>
                                    <field name="cushion_amount" widget="monetary" readonly="1"
                                           string="6. Tổng gối thêm (= 4 - 5)"/>
                                </group>
                                <group string="Chi phí cho khách hàng">
                                    <label for="referral_commission_percent" string="7. Hoa hồng"/>
                                    <div class="o_row">
                                        <field name="referral_commission_percent" class="oe_inline"/> %
                                        <span class="mx-2">=</span>
                                        <field name="referral_commission" widget="monetary" readonly="1" class="oe_inline"/>
                                    </div>
                                    <field name="customer_support_cost" widget="monetary" readonly="1"
                                           string="8. Tổng chi phí cho khách (= 6 + 7)"
                                           class="oe_subtotal_footer_separator"/>
                                    <field name="business_cost_total" widget="monetary" readonly="1"
                                           string="Tổng chi phí KD (= 5 + 8)"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>

                            <separator string="Lợi nhuận"/>
                            <group>
                                <group string="Lợi nhuận dự kiến">
                                    <field name="expected_profit" widget="monetary"
                                           string="9. Lợi nhuận (= 4 - 5 - 7)"
                                           class="oe_subtotal_footer_separator"/>
                                    <field name="expected_margin_percent" widget="percentage"
                                           string="Tỷ lệ lãi (%)"/>
                                </group>
                            </group>
                        </page>

                        <page string="Ghi chú" name="notes">
                            <field name="note" placeholder="Ghi chú nội bộ về phương án này..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- PAKD Search View -->
    <record id="view_dtx_pakd_search" model="ir.ui.view">
        <field name="name">dtx.pakd.search</field>
        <field name="model">dtx.pakd</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm PAKD">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="end_customer_id"/>
                <field name="owner_user_id"/>
                <separator/>
                <filter name="my_pakd" string="PAKD của tôi"
                        domain="[('owner_user_id', '=', uid)]"/>
                <filter name="draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Đã trình"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Đã duyệt"
                        domain="[('state', '=', 'approved')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_sale_order" string="Báo giá"
                            context="{'group_by': 'sale_order_id'}"/>
                    <filter name="group_partner" string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_owner" string="Sale phụ trách"
                            context="{'group_by': 'owner_user_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- PAKD Action -->
    <record id="action_dtx_pakd" model="ir.actions.act_window">
        <field name="name">Phương án kinh doanh (PAKD)</field>
        <field name="res_model">dtx.pakd</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_pakd': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phương án kinh doanh (PAKD) mới
            </p>
            <p>
                PAKD cho phép bạn lập nhiều phương án giá nhập/giá bán cho cùng 1 báo giá,
                so sánh lợi nhuận, rồi apply phương án tốt nhất vào đơn hàng.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_dtx_pakd"
              name="PAKD"
              parent="sale.sale_order_menu"
              action="action_dtx_pakd"
              sequence="10"/>

</odoo>
